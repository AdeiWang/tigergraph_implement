CREATE VERTEX RF_CUSTOMER (
  id STRING PRIMARY KEY,
  c_custkey INT,
  c_name STRING,
  c_address STRING,
  c_phone STRING,
  c_acctbal DOUBLE,
  c_mktsegment STRING,
  c_comment STRING
)

CREATE VERTEX RF_PART (
  id STRING PRIMARY KEY,
  p_partkey INT
)

CREATE VERTEX RF_SUPPLIER (
  id STRING PRIMARY KEY,
  s_suppkey INT
)

CREATE VERTEX RF_PARTSUPP (
  id STRING PRIMARY KEY,
  ps_availqty INT,
  ps_supplycost DOUBLE,
  ps_comment STRING
)

CREATE VERTEX RF_ORDERS (
  id STRING PRIMARY KEY,
  o_orderkey INT,
  o_orderstatus STRING,
  o_totalprice DOUBLE,
  o_orderdate DATETIME,
  o_orderpriority STRING,
  o_clerk STRING,
  o_shippriority INT,
  o_comment STRING
)

CREATE VERTEX RF_LINEITEM (
  id STRING PRIMARY KEY,
  l_linenumber INT,
  l_quantity DOUBLE,
  l_extendedprice DOUBLE,
  l_discount DOUBLE,
  l_tax DOUBLE,
  l_returnflag STRING,
  l_linestatus STRING,
  l_shipdate DATETIME,
  l_commitdate DATETIME,
  l_receiptdate DATETIME,
  l_shipinstruct STRING,
  l_shipmode STRING,
  l_comment STRING
)

CREATE DIRECTED EDGE RF_ORDERS_CUSTOMER (FROM RF_ORDERS, TO RF_CUSTOMER)
CREATE DIRECTED EDGE RF_PARTSUPP_PART (FROM RF_PARTSUPP, TO RF_PART)
CREATE DIRECTED EDGE RF_PARTSUPP_SUPPLIER (FROM RF_PARTSUPP, TO RF_SUPPLIER)
CREATE DIRECTED EDGE RF_LINEITEM_ORDERS (FROM RF_LINEITEM, TO RF_ORDERS)
CREATE DIRECTED EDGE RF_LINEITEM_PARTSUPP (FROM RF_LINEITEM, TO RF_PARTSUPP)

CREATE GRAPH TPCH_RF_G (
  RF_CUSTOMER,
  RF_PART,
  RF_SUPPLIER,
  RF_PARTSUPP,
  RF_ORDERS,
  RF_LINEITEM,
  RF_ORDERS_CUSTOMER,
  RF_PARTSUPP_PART,
  RF_PARTSUPP_SUPPLIER,
  RF_LINEITEM_ORDERS,
  RF_LINEITEM_PARTSUPP
)
